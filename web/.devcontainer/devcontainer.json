{
  "name": "Dev VanillaJS + PNPM",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=/etc/passwd,target=/etc/passwd:ro,type=bind,consistency=cached",
    "source=/etc/group,target=/etc/group:ro,type=bind,consistency=cached",
    "source=pnpm-volumen,target=${localWorkspaceFolder}/node_modules,type=volume"
  ], 
  "shutdownAction": "none",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint", // ESLint
        "esbenp.prettier-vscode" // Prettier
      ]
    }
  }
}