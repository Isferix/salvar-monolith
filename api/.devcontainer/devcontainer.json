{
  "name": "API Dev",
  "dockerComposeFile": ["../../.deploy/docker-compose.dev.yml"],
  "service": "api",
  "workspaceFolder": "/code",
  "shutdownAction": "none",
  "updateRemoteUserUID": true,  
  "mounts": [
    "source=venv-volume,target=/opt/venv,type=volume"
  ],
  "postCreateCommand": "uv sync --all-groups --frozen --active",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "mouradghafiri.uv-vscode-extension",
        "charliermarsh.ruff"
      ]
    }
  }
}