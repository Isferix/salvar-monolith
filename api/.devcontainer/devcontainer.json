{
  "name": "API salvar-dev",
  "dockerComposeFile": ["../../.deploy/docker-compose.dev.yml"],
  "service": "api",
  "workspaceFolder": "/code",
  "shutdownAction": "none",
  "updateRemoteUserUID": true,  
  "mounts": [
    // Volumen único para este proyecto específico
    "source=venv-${localWorkspaceFolderBasename},target=/opt/venv,type=volume",
    // Volumen global compartido para no descargar paquetes 2 veces
    "source=uv-global-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "postCreateCommand": "uv sync --all-groups --frozen --inexact",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/opt/venv/bin/python3.13",
        "python.analysis.extraPaths": ["/code"]
      },
      "extensions": [
        "ms-python.python",
        "wholroyd.jinja",
        "ms-python.debugpy",
        "mouradghafiri.uv-vscode-extension",
        "charliermarsh.ruff",
      ]
    }
  }
}